# Variante portable del dashboard Spark V2. PENDIENTE de probar en clúster.
# Requiere server-v2.js y public/ del paquete de despliegue original.
FROM node:22-alpine
WORKDIR /app
COPY server-v2.js /app/server-v2.js
COPY public/ /app/public-v2/
ENV NODE_ENV=production PORT=8080 NOVATIX_REPORTE=/resultados/reporte_novatix_v2.json
EXPOSE 8080
CMD ["node", "/app/server-v2.js"]
